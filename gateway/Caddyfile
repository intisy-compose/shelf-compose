# The shared gateway from intisy-compose/workflows gateway/, vendored byte for byte; a stack's own
# sites live in sites.caddy. tailscale shares this container's network namespace, and certificates
# for the ts.net name come from tailscaled over its socket, never from a public CA.
{
	admin off
	auto_https disable_redirects
}

(tailnet) {
	tls {
		get_certificate tailscale
	}
}

import sites.caddy
