# Copy to config.env (gitignored), or run `.\docker-compose.ps1 init-config`, which copies this file
# and fills every empty secret below with a freshly generated value.

# Tailscale. shelf joins your tailnet as TS_HOSTNAME and is served at https://<TS_HOSTNAME>.<tailnet>.ts.net
# (Supabase on :8443 of the same name). TS_AUTHKEY is only needed for the first join; create one at
# https://login.tailscale.com/admin/settings/keys. HTTPS certificates must be enabled for the tailnet.
TS_AUTHKEY=
TS_HOSTNAME=shelf

# Written by `docker-compose.ps1 up` once the node has joined; leave them empty.
SHELF_HOST=
SERVER_URL=
SUPABASE_URL=

# Mailpit's web UI, on this machine only.
MAILPIT_PORT=8025

# Generated by init-config. ANON_KEY and SERVICE_ROLE_KEY are JWTs signed with JWT_SECRET, so
# regenerate all three together or not at all.
POSTGRES_PASSWORD=
JWT_SECRET=
ANON_KEY=
SERVICE_ROLE_KEY=
SESSION_SECRET=
INVITE_TOKEN_SECRET=
FINGERPRINT=

# Mail. The default is the bundled Mailpit, which delivers nothing and shows every message at
# http://localhost:8025, login codes included. For real delivery point these at your SMTP server;
# port 465 uses TLS, any other port plain SMTP.
SMTP_HOST=mail
SMTP_PORT=1025
SMTP_USER=
SMTP_PASS=
SMTP_FROM="shelf <shelf@localhost>"
SMTP_ADMIN_EMAIL=shelf@localhost
SMTP_SENDER_NAME=shelf

# shelf requires a value here; maps stay blank until you set a real MapTiler token.
MAPTILER_TOKEN=none
GEOCODING_USER_AGENT="Self-hosted shelf"

DISABLE_SIGNUP=false

# How many hourly database dumps data/backups keeps.
BACKUP_KEEP=48
